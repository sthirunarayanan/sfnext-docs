{
    "hosting": {
        "public": "dist",
        "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
        "rewrites": [
            { "source": "/api/scapi-token", "function": "scapiToken" },
            { "source": "/api/unifi-token", "function": "unifiToken" },
            { "source": "/api/unifi-dpos-token", "function": "unifiDposToken" },
            { "source": "/api/unifi-lookup-transaction", "function": "unifiLookupTransaction" },
            { "source": "/api/unifi-transact", "function": "unifiTransact" },
            { "source": "**", "destination": "/index.html" }
        ]
    },
    "functions": [
        {
            "source": "functions",
            "codebase": "default",
            "ignore": ["node_modules", ".git", "firebase-debug.log", "firebase-debug.*.log"]
        }
    ]
}

