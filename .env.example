# Copy to .env and fill in with the output of:
#   node scripts/hash-password.mjs "your-password-here"
#
# Required to unlock the site locally (pnpm dev) and in any production build
# (pnpm build) — set this as a build-time environment variable on your
# hosting provider (Vercel/Netlify/etc.) so it's baked in before deploy.
VITE_DOCS_PASSWORD_HASH=

# Separate password gating only the hidden "Unifi Demo" section (not listed in
# the sidebar nav). Generate with:
#   node scripts/hash-password.mjs "your-unifi-demo-password-here"
# If unset, the section is open in local dev but shows a misconfiguration
# notice in production builds.
VITE_UNIFI_DEMO_PASSWORD_HASH=

# Separate password gating only the "Unifi Documentation" page (/unifi-docs).
# Independent of VITE_UNIFI_DEMO_PASSWORD_HASH above. Generate with:
#   node scripts/hash-password.mjs "your-unifi-docs-password-here"
# If unset, the page is open in local dev but shows a misconfiguration
# notice in production builds.
VITE_UNIFI_DOCS_PASSWORD_HASH=

